---
// A large search button for landing pages. It opens the site search dialog from the header.
interface Props {
	label?: string;
}
const { label = 'Search the docs, or paste an error message' } = Astro.props;
---

<div class="search-cta not-content">
	<button type="button" data-search-cta>
		<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
			<path
				d="M21.71 20.29 18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a1 1 0 0 0 1.42 0 1 1 0 0 0 0-1.39ZM11 18a7 7 0 1 1 7-7 7 7 0 0 1-7 7Z"
			></path>
		</svg>
		<span>{label}</span>
	</button>
</div>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-search-cta]')) {
		button.addEventListener('click', () => {
			document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click();
		});
	}
</script>

<style>
	.search-cta {
		margin: 0 auto 2.5rem;
		max-width: 40rem;
	}
	.search-cta button {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-base);
		cursor: pointer;
		text-align: start;
	}
	.search-cta button:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
</style>
